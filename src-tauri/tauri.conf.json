{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "brone-gui",
  "version": "0.1.0",
  "identifier": "com.brone.gui",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:3000/src",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Brone",
        "width": 1024,
        "height": 600,
        "fullscreen": false,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#CBD8E2"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}

